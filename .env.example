DATABASE_URL=postgres://postgres:postgres@postgres:5432/shodh
# Local (non-compose) default: postgres://postgres:postgres@localhost:5432/shodh
PORT=3000
# Dev-auth fixture: Authorization: Bearer dev:<user-uuid> (see seed data).
# Judge execution mode: real | double (test double; no Docker needed)
JUDGE_MODE=real
# Runner container image built from judge/Dockerfile.runner
JUDGE_IMAGE=shodh-runner:latest
# Resource bounds for submitted code (also enforced inside the runner)
JUDGE_CPU=0.5
JUDGE_MEMORY_MB=128
JUDGE_PIDS_LIMIT=64
JUDGE_MAX_OUTPUT_BYTES=1048576
# Controlled runner failure for recovery testing: none | crash_before_verdict | crash_after_judge
JUDGE_FAILPOINT=none
# Worker identity (set per process; defaults to hostname+pid)
WORKER_ID=
# Stale-running requeue threshold (seconds without heartbeat)
WORKER_STALE_AFTER_SECONDS=120
